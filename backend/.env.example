# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ludoline
DB_USER=ludoline_user
DB_PASSWORD=your_db_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Telebirr (USSDPush / OpenAPI)
TELEBIRR_APP_ID=your_telebirr_app_id
TELEBIRR_APP_KEY=your_telebirr_app_key
TELEBIRR_PUBLIC_KEY=your_telebirr_public_key
TELEBIRR_SHORT_CODE=your_short_code
TELEBIRR_NOTIFY_URL=https://yourdomain.com/api/payments/telebirr/callback
TELEBIRR_BASE_URL=https://196.188.120.3:9443/ussd-provider/api/cashIn

# OTP (SMS Gateway - e.g. Afro SMS or similar Ethiopian provider)
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://api.smsprovider.com/send
SMS_SENDER_ID=LUDOLINE

# Platform fees
PLATFORM_FEE_ACCOUNT=your_platform_telebirr_number

# Admin
ADMIN_EMAIL=admin@ludoline.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Frontend URLs (for CORS)
WEB_APP_URL=http://localhost:3000
MOBILE_APP_SCHEMA=ludoline

# Minimum/Maximum bet in ETB
MIN_BET=2
MAX_BET=10000

# OTP expiry in minutes
OTP_EXPIRES_MINUTES=5

# ─── Telegram Bot Integration ─────────────────────────────────────────────
# Name of the Telegram bot (without @)
TELEGRAM_BOT_NAME=LudolineVerifyBot

# The @LudolineVerifyBot backend service URL (separate deployment)
TELEGRAM_BOT_SERVICE_URL=http://localhost:4000

# Shared secret between Ludoline backend and the bot service
# Must be the same value in both services. Generate with: openssl rand -hex 32
TELEGRAM_BOT_SERVICE_SECRET=change_me_generate_with_openssl_rand_hex_32

# HMAC signing secret for linking tokens (can reuse JWT_SECRET or use a separate one)
TELEGRAM_HMAC_SECRET=change_me_separate_hmac_secret_32_chars_min
